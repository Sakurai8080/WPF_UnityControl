<UserControl
    x:Class="WPF_UnityControl.Control.LogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_UnityControl.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="300"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="280*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock VerticalAlignment="Center" Text="ログ情報" />
            <Button
                Width="60"
                Height="23"
                Margin="0,0,0,5"
                Padding="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Command="{Binding LogClear}">
                <TextBlock
                    Padding="0,1,0,0"
                    FontSize="12"
                    Text="クリア" />
            </Button>
        </Grid>
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource 900Blush}"
            BorderThickness="2">
            <ScrollViewer x:Name="logScrollViewer">
                <TextBlock
                    Background="#FF121212"
                    FontSize="16"
                    Foreground="Gray"
                    Text="{Binding Log.Value, NotifyOnTargetUpdated=True}"
                    TextWrapping="Wrap" TargetUpdated="TextBlock_TargetUpdated" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
